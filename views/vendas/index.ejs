<%- include("../layout/header", { title: "Vendas" }) %>

<div class="stack">
  <div class="card card--soft">
    <div class="page-head">
      <div class="page-head__title">
        <h1>Histórico de Vendas</h1>
        <p class="muted"><strong>Supermercado:</strong> <%= supermercado.nome %></p>
      </div>
      <div class="page-head__actions">
        <a class="btn btn--primary" href="/vendas/nova">Nova Venda</a>
        <a class="btn btn--ghost" href="/supermercado/dashboard">Voltar</a>
      </div>
    </div>
  </div>

  <div class="card">
    <% if (vendas.length > 0) { %>
      <table>
        <tr>
          <th>Cliente</th>
          <th>Produtos</th>
          <th>Total</th>
          <th>Entrega</th>
          <th>Data</th>
          <th>Ações</th>
        </tr>

        <% vendas.forEach(venda => { %>
          <tr>
            <td><%= venda.cliente ? venda.cliente.nome : "Sem cliente" %></td>

            <td>
              <ul>
                <% venda.produtos.forEach(item => { %>
                  <li>
                    <%= item.produto ? item.produto.nome : "Produto removido" %>
                    x <%= item.quantidade %>
                  </li>
                <% }) %>
              </ul>
            </td>

            <td>€<%= venda.total.toFixed(2) %></td>
            <td>
              <% if (venda.tipoEntrega === "domicilio") { %>
                <div class="stack">
                  <span class="pill">Domicílio</span>
                  <span class="muted"><%= venda.metodoEntrega || "—" %></span>
                  <span class="pill"><%= venda.estadoEntrega || "pendente" %></span>
                </div>
              <% } else { %>
                <div class="stack">
                  <span class="muted">Em loja</span>
                  <span class="pill"><%= venda.estadoEntrega || "confirmada" %></span>
                </div>
              <% } %>
            </td>
            <td><%= venda.createdAt ? new Date(venda.createdAt).toLocaleString() : "Sem data" %></td>
            <td>
              <% const createdAt = venda.createdAt ? new Date(venda.createdAt).getTime() : 0; %>
              <% const cancelavel = venda.createdAt && !["entregue", "cancelada", "em_transito"].includes(venda.estadoEntrega) && (Date.now() - createdAt) <= 5 * 60 * 1000; %>
              <% if (cancelavel) { %>
                <form action="/vendas/<%= venda._id %>/cancelar" method="POST" style="margin:0;">
                  <button class="btn btn--danger btn--sm" type="submit">Cancelar</button>
                </form>
              <% } else { %>
                <span class="muted">—</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </table>
    <% } else { %>
      <p class="muted">Ainda não existem vendas registadas.</p>
    <% } %>
  </div>
</div>

<%- include("../layout/footer") %>
